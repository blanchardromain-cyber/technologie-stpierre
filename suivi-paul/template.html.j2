<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mon Planning – Paul · Technologie St-Pierre</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0f1117;
    --surface: #181c27;
    --card: #1e2334;
    --border: #2a3050;
    --accent: #4f8ef7;
    --accent2: #38d9a9;
    --warn: #ffa94d;
    --text: #e8eaf6;
    --muted: #7b84a8;
    --done: #38d9a9;
    --locked: #404668;
    --soon: #2a3050;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'DM Sans', sans-serif;
    min-height: 100vh;
    padding: 24px 16px 60px;
  }

  /* Background grid */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(79,142,247,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(79,142,247,0.04) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 0;
  }

  .wrapper {
    max-width: 680px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  /* Header */
  .header {
    text-align: center;
    margin-bottom: 36px;
    padding: 40px 24px 36px;
    background: var(--surface);
    border-radius: 20px;
    border: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }
  .header::before {
    content: '';
    position: absolute;
    top: -60px; left: 50%; transform: translateX(-50%);
    width: 300px; height: 300px;
    background: radial-gradient(circle, rgba(79,142,247,0.15) 0%, transparent 70%);
    pointer-events: none;
  }
  .header-badge {
    display: inline-block;
    background: rgba(79,142,247,0.12);
    border: 1px solid rgba(79,142,247,0.3);
    color: var(--accent);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 5px 14px;
    border-radius: 20px;
    margin-bottom: 16px;
  }
  .header h1 {
    font-family: 'Syne', sans-serif;
    font-size: clamp(28px, 6vw, 42px);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 8px;
  }
  .header h1 span { color: var(--accent); }
  .header p {
    color: var(--muted);
    font-size: 14px;
    margin-bottom: 28px;
  }

  /* Progress bar */
  .progress-wrap {
    background: var(--border);
    border-radius: 10px;
    height: 8px;
    margin-bottom: 8px;
    overflow: hidden;
  }
  .progress-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    border-radius: 10px;
    width: {{ progress_pct }}%;
    transition: width 0.6s ease;
  }
  .progress-label {
    font-size: 12px;
    color: var(--muted);
    text-align: right;
  }
  .progress-label strong { color: var(--accent2); }

  /* Connect button */
  .connect-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(135deg, var(--accent), #3a7de8);
    color: white;
    text-decoration: none;
    padding: 14px 28px;
    border-radius: 12px;
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    font-weight: 600;
    margin-top: 24px;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 20px rgba(79,142,247,0.35);
  }
  .connect-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(79,142,247,0.45);
  }
  .connect-btn svg { flex-shrink: 0; }

  /* Week cards */
  .weeks { display: flex; flex-direction: column; gap: 16px; }

  .week-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.2s, border-color 0.2s;
  }
  .week-card:hover { transform: translateY(-1px); }

  .week-card.status-active { border-color: rgba(79,142,247,0.5); }
  .week-card.status-done { border-color: rgba(56,217,169,0.4); }
  .week-card.status-locked { opacity: 0.7; }
  .week-card.status-soon { opacity: 0.5; }

  .week-header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    cursor: pointer;
    user-select: none;
  }
  .week-header:hover { background: rgba(255,255,255,0.02); }

  .week-num {
    font-family: 'Syne', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--muted);
    min-width: 60px;
  }

  .status-dot {
    width: 10px; height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .status-active .status-dot { background: var(--accent); box-shadow: 0 0 8px var(--accent); }
  .status-done .status-dot { background: var(--done); box-shadow: 0 0 8px var(--done); }
  .status-locked .status-dot { background: var(--locked); }
  .status-soon .status-dot { background: var(--border); }

  .week-title-wrap { flex: 1; min-width: 0; }
  .week-dates {
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 2px;
  }
  .week-title {
    font-weight: 600;
    font-size: 15px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .status-pill {
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 20px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .pill-active { background: rgba(79,142,247,0.15); color: var(--accent); border: 1px solid rgba(79,142,247,0.3); }
  .pill-done { background: rgba(56,217,169,0.12); color: var(--done); border: 1px solid rgba(56,217,169,0.3); }
  .pill-locked { background: rgba(64,70,104,0.4); color: var(--muted); border: 1px solid var(--border); }
  .pill-soon { background: transparent; color: var(--muted); border: 1px solid var(--border); }

  .chevron {
    color: var(--muted);
    transition: transform 0.3s;
    flex-shrink: 0;
  }
  .week-card.open .chevron { transform: rotate(180deg); }

  /* Week body */
  .week-body {
    display: none;
    padding: 0 20px 20px;
    border-top: 1px solid var(--border);
  }
  .week-card.open .week-body { display: block; }

  .activity-block {
    background: rgba(255,255,255,0.03);
    border-radius: 10px;
    padding: 16px;
    margin-top: 16px;
  }
  .activity-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .activity-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text);
  }

  .code-box {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(79,142,247,0.08);
    border: 1px solid rgba(79,142,247,0.2);
    border-radius: 10px;
    padding: 12px 16px;
    margin-top: 12px;
  }
  .code-box-icon { font-size: 18px; }
  .code-box-label { font-size: 12px; color: var(--muted); }
  .code-box-value {
    font-family: 'Courier New', monospace;
    font-size: 18px;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 3px;
  }

  .pix-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 14px;
    padding: 16px;
    background: linear-gradient(135deg, #1a73e8, #0d47a1);
    color: white;
    text-decoration: none;
    border-radius: 12px;
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.3px;
    box-shadow: 0 4px 20px rgba(26,115,232,0.45);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .pix-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(26,115,232,0.55);
  }

  .locked-box {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(42,48,80,0.5);
    border: 1px dashed var(--border);
    border-radius: 10px;
    padding: 14px 16px;
    margin-top: 12px;
    color: var(--muted);
    font-size: 13px;
  }
  .locked-box-icon { font-size: 20px; }

  /* Signal block */
  .signal-block {
    margin-top: 16px;
    border-top: 1px solid var(--border);
    padding-top: 16px;
  }
  .signal-label {
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .msg-preview {
    background: rgba(255,255,255,0.04);
    border-radius: 10px;
    padding: 12px 14px;
    font-size: 13px;
    line-height: 1.6;
    color: #c0c8e8;
    border-left: 3px solid var(--accent2);
    font-style: italic;
    margin-bottom: 10px;
  }
  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(56,217,169,0.12);
    border: 1px solid rgba(56,217,169,0.3);
    color: var(--accent2);
    padding: 10px 18px;
    border-radius: 10px;
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
    width: 100%;
    justify-content: center;
  }
  .copy-btn:hover { background: rgba(56,217,169,0.2); transform: translateY(-1px); }
  .copy-btn.copied {
    background: rgba(56,217,169,0.25);
    color: var(--done);
  }
  .copy-hint {
    font-size: 11px;
    color: var(--muted);
    text-align: center;
    margin-top: 6px;
  }

  /* Soon card */
  .soon-content {
    padding: 14px 20px;
    display: none;
  }
  .week-card.status-soon.open .soon-content { display: block; }
  .soon-text {
    color: var(--muted);
    font-size: 13px;
    font-style: italic;
  }

  /* Footer */
  .footer {
    text-align: center;
    margin-top: 32px;
    color: var(--muted);
    font-size: 12px;
  }
  .footer a { color: var(--accent); text-decoration: none; }

  @media (max-width: 480px) {
    .week-title { font-size: 13px; }
    .status-pill { font-size: 10px; padding: 3px 8px; }
  }
</style>
</head>
<body>
<div class="wrapper">

  <!-- HEADER -->
  <div class="header">
    <div class="header-badge">📚 Technologie · Collège St-Pierre</div>
    <h1>Bonjour <span>Paul</span> ! 👋</h1>
    <p>Ton planning personnalisé · {{ school_year }}</p>

    <div class="progress-wrap">
      <div class="progress-bar" id="progressBar"></div>
    </div>
    <div class="progress-label">
      <strong id="doneCount">{{ done_count }}</strong> / {{ total_weeks }} semaines complétées
    </div>

    <br>
    <a class="connect-btn" href="{{ site_url }}" target="_blank">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
      {{ site_label }}
    </a>
  </div>

  <!-- WEEKS -->
  <div class="weeks">
{% for w in weeks %}
    <!-- SEMAINE {{ w.num }} ({{ w.status | upper }}) -->
    <div class="week-card status-{{ w.status }}{% if w.is_open %} open{% endif %}" id="week{{ w.num }}">
      <div class="week-header" onclick="toggleWeek('week{{ w.num }}')">
        <div class="week-num">Sem. {{ w.num }}</div>
        <div class="status-dot"></div>
        <div class="week-title-wrap">
          <div class="week-dates">{{ w.dates_label }}</div>
          <div class="week-title">{{ w.display_title }}</div>
        </div>
        <span class="status-pill pill-{{ w.status }}">{{ w.pill_text }}</span>
        <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
      </div>
{% if w.status == 'soon' %}
      <div class="soon-content">
        <div class="soon-text">{{ w.soon_text }}</div>
      </div>
{% else %}
      <div class="week-body">
{% if w.activity_label %}
        <div class="activity-block">
          <div class="activity-label">{{ w.activity_label }}</div>
          <div class="activity-desc">
            {{ w.activity_html | safe }}
          </div>
{% if w.show_code %}
          <div class="code-box">
            <div class="code-box-icon">🔑</div>
            <div>
              <div class="code-box-label">{{ w.code_label }}</div>
              <div class="code-box-value">{{ w.code }}</div>
            </div>
          </div>
{% if w.link_url %}
          <a href="{{ w.link_url }}" target="_blank" class="pix-btn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            {{ w.link_label }}
          </a>
{% endif %}
{% else %}
          <div class="locked-box">
            <div class="locked-box-icon">🔒</div>
            <div>{{ w.locked_text }}</div>
          </div>
{% endif %}
        </div>
{% endif %}
{% if w.signal_intro %}
        <div class="signal-block">
          <div class="signal-label">
            {{ w.signal_intro }}
          </div>
          <div class="msg-preview">
            {{ w.signal_message_html | safe }}
          </div>
          <button class="copy-btn" onclick="copyMsg(this, '{{ w.signal_message_js }}')">
            📋 Copier le message
          </button>
          <div class="copy-hint">Puis colle-le dans la messagerie Ecole Directe 📨</div>
        </div>
{% endif %}
      </div>
{% endif %}
    </div>
{% endfor %}
  </div><!-- /weeks -->

  <div class="footer">
    <p>Collège Saint-Pierre · Technologie · M. Blanchard</p>
    <p style="margin-top:4px"><a href="{{ site_url }}" target="_blank">→ Site Technologie</a></p>
    <p style="margin-top:8px;font-size:10px;opacity:0.6">Dernière mise à jour automatique : {{ generated_at }}</p>
  </div>

</div><!-- /wrapper -->

<script>
  function toggleWeek(id) {
    const card = document.getElementById(id);
    card.classList.toggle('open');
  }

  function copyMsg(btn, text) {
    navigator.clipboard.writeText(text).then(() => {
      const original = btn.innerHTML;
      btn.innerHTML = '✅ Message copié !';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.innerHTML = original;
        btn.classList.remove('copied');
      }, 2500);
    }).catch(() => {
      // Fallback for older browsers
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      const original = btn.innerHTML;
      btn.innerHTML = '✅ Message copié !';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.innerHTML = original;
        btn.classList.remove('copied');
      }, 2500);
    });
  }
</script>
</body>
</html>
